# ============================================================
# KPR Food Court — Application Environment Configuration
# ============================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Database Configuration (MySQL 8.0)
# Note: If MySQL credentials are not provided or connection fails,
# the system automatically fails over to backend/food_court_local.db (SQLite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=food_court_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
