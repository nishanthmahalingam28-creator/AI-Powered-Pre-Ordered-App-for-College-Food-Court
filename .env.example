# ============================================================
# KPR Food Court — Application Environment Configuration
# ============================================================

# Server Mode: 'development' or 'production'
# In 'production':
#   - SECRET_KEY is STRICTLY REQUIRED (app refuses to start if missing)
#   - MySQL connection is STRICTLY REQUIRED (SQLite fallback is disabled)
#   - Debug mode is STRICTLY DISABLED
#   - Insecure wildcard CORS ('*') with credentials is strictly rejected
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Cryptographic Session Secret Key
# In production, generate a secure random 64-character hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Database Configuration (MySQL 8.0)
# Required in production. In development, if connection fails or USE_SQLITE=1, falls back to backend/food_court_local.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=food_court_db
DB_TIMEOUT=5

# Alternative: unified database connection URL (optional)
# DATABASE_URL=mysql://root:your_mysql_password_here@127.0.0.1:3306/food_court_db

# Development-only database toggle (Ignored and strictly disabled in production)
USE_SQLITE=0

# CORS Allowed Origins (Comma-separated)
# In production, set to your specific production frontend URL(s)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Cookie Security (HTTPS)
# 0 = Allow over HTTP (required for local development on localhost)
# 1 = Enforce Secure flag on cookies (recommended for production HTTPS)
COOKIE_SECURE=0

# ============================================================
# Payment Gateway Configuration (Razorpay)
# ============================================================
# Provider: 'razorpay'
PAYMENT_PROVIDER=razorpay

# Environment: 'test' for development sandbox, 'production' for live payments
PAYMENT_ENVIRONMENT=test

# Razorpay API Credentials
# In development/test mode (FLASK_ENV=development or testing):
#   Test credentials (rzp_test_...) may be supplied for sandbox testing.
# In production mode (FLASK_ENV=production):
#   Live production credentials (rzp_live_...) and webhook secret are STRICTLY REQUIRED.
#   The application enforces FAIL-FAST validation: boots are strictly rejected if test keys or placeholders are detected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# Email / SMTP Configuration (Password Reset & Security Alerts)
# ============================================================
# Configure SMTP credentials to enable automated password reset emails.
# If not configured, the backend logs a configuration notice and enables the safe backend interface.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=foodcourt@kpriet.ac.in
SMTP_PASS=your_smtp_app_password_here
SMTP_USE_TLS=1
MAIL_DEFAULT_SENDER="KPRIET Smart Food Court <noreply@kpriet.ac.in>"

# ============================================================
# Frontend URL Configuration (Password Reset Links & CORS)
# ============================================================
# In production, set to your deployed frontend domain:
# FRONTEND_URL=https://college-food-court-frontend.onrender.com
APP_URL=http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500

# ============================================================
# SMS / Mobile OTP Delivery Configuration (Twilio Verify)
# ============================================================
# Supported provider: 'twilio_verify' (recommended) or 'twilio'
# In development, if unconfigured, safe dev/test mode is used.
# In production, valid provider credentials are REQUIRED for real SMS delivery.
SMS_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ============================================================
# Administrator Root Account Configuration (Render & Production)
# ============================================================
# Automatically provisions or resets the root administrator account on startup.
# In production on Render, set these environment variables to establish or rotate admin credentials.
ADMIN_EMAIL=admin@kpriet.ac.in
ADMIN_PASSWORD=change-to-your-strong-admin-password
