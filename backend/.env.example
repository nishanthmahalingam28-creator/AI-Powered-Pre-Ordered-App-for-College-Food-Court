# ============================================================
# KPR Food Court Backend — Environment Configuration
# ============================================================

FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=food_court_db
DB_TIMEOUT=5

# USE_SQLITE is only respected when FLASK_ENV=development.
# In production, SQLite is strictly forbidden and MySQL is mandatory.
USE_SQLITE=0

# Frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
COOKIE_SECURE=0
